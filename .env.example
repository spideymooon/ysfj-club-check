# ============================================================
# 有赞每日自动签到 - 配置样例
# 复制为 .env 后按需修改。.env 已被 .gitignore 排除，切勿提交。
# 严禁在本文件或代码中填写 Cookie / 密码 / 短信验证码。
# ============================================================

# ---------- 站点与接口 ----------
BASE_URL=https://club.ysjf.com
# 用户已确认的两个参数（公开的活动 ID，非凭证）
CHECKIN_ID=6287727
KDT_ID=149536603
CHECKIN_API=https://club.ysjf.com/wscump/checkin/checkinV2.json
# 实测发现的配套查询接口，用于「今日是否已签到」前置检查
ACTIVITY_API=https://club.ysjf.com/wscump/checkin/get_activity_by_yzuid_v2.json
RESULT_PAGE=https://club.ysjf.com/wscump/checkin/result?kdt_id=149536603

# 若抓包发现还需要额外参数 / 请求头，用 JSON 字符串补充（不要放任何凭证）
# 例：EXTRA_QUERY={"app_id":"xxx"}
# 例：EXTRA_HEADERS={"Extra-Data":"{}"}
EXTRA_QUERY=
EXTRA_HEADERS=

# ---------- 调度 ----------
TIMEZONE=Asia/Shanghai
SCHEDULE_HOUR=8
SCHEDULE_MINUTE=0
# 容器启动时是否立即补签一次（错过 08:00 时有用）
RUN_ON_STARTUP=false

# ---------- 浏览器 ----------
# 日常签到用无头；首次登录 / 重新登录必须设为 false
HEADLESS=true
# 本地 Windows 可填 chrome 复用已安装的 Chrome，免下载内置 Chromium；
# Docker 内留空，使用镜像内置的 Chromium。
BROWSER_CHANNEL=
# 人工登录最长等待秒数
LOGIN_WAIT_SECONDS=600

# ---------- 网页控制台 ----------
# 默认只允许本机访问；如需局域网访问（有安全风险）改为 0.0.0.0
WEB_HOST=127.0.0.1
WEB_PORT=8787

# ---------- 请求 / 幂等 / 重试 ----------
REQUEST_TIMEOUT=30
MAX_RETRY=3
RETRY_BACKOFF=30
# 签到前先查 isCheckin，已签到则直接跳过，不发签到请求
PRECHECK_ENABLED=true
# 从真实页面请求中捕获并复用参数 / 请求头
CAPTURE_ENABLED=true

# ---------- 运行期路径（Docker 内由 compose 覆盖为 /app/data）----------
DATA_DIR=./data

# ---------- PushPlus 微信通知 ----------
PUSHPLUS_ENABLED=true
# 在 https://www.pushplus.plus 获取，只填在这里，绝不写入代码 / 日志
PUSHPLUS_TOKEN=
# 可选：群组编码，不填仅推送给自己
PUSHPLUS_TOPIC=
PUSHPLUS_CHANNEL=wechat
PUSHPLUS_TEMPLATE=html
NOTIFY_ON_SUCCESS=true
NOTIFY_ON_ALREADY=false
NOTIFY_ON_FAILURE=true

# 登录失效通知中展示的重新登录指引
LOGIN_HINT=请在 NAS 上打开 http://<NAS_IP>:6080/vnc.html 完成网页登录，或本地执行 python -m app.main login
